# AdaptixC2 MCP environment template.
# Copy to /opt/adaptix-mcp/mcp.env and chmod 600. Never commit the real file.
ADAPTIX_USERNAME=auto
ADAPTIX_PASSWORD=change-me
ADAPTIX_ENDPOINT=127.0.0.1:4321/endpoint

# Optional overrides
# ADAPTIX_SLOT_DIR=/opt/adaptix-mcp/slots
# ADAPTIX_SLOT_COUNT=128
# ADAPTIX_CMD_TIMEOUT=300
# ADAPTIX_NOTES_DIR=~/.adaptix-mcp/notes
# ADAPTIX_PAYLOADS_DIR=/opt/projects/AdaptixC2-Workspace/src/teamserver/payloads
